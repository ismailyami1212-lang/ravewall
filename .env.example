# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=production
# The single public port the HTTP service listens on (platforms usually inject
# PORT themselves).
PORT=3001
# Bind address. Keep 0.0.0.0 so a reverse proxy or container can reach it.
HOST=0.0.0.0
# Public origin of the deployment, e.g. https://kudos.example.com
APP_URL=

# ---------------------------------------------------------------------------
# Database (Supabase Postgres) — REQUIRED
# ---------------------------------------------------------------------------
# Supabase dashboard → Connect → Connection string → URI.
#
# Runtime connection: the **Transaction pooler** (port 6543). It multiplexes many
# clients onto few backends, which is what a serverless platform needs.
#
# This value is server-side only. It is never sent to the browser, and no
# Supabase API key is used anywhere in this project.
SUPABASE_DB_URL=

# Migration connection: the **Session pooler** (port 5432).
#
# Migrations take a Postgres advisory lock, and advisory locks are session
# scoped. The transaction pooler may hand each statement to a different backend,
# so the lock would not hold there. The session pooler keeps one backend for the
# whole session.
#
# ADMIN ONLY. Read by `npm run migrate` and `npm run verify:deployment` — never
# by the running server. Do NOT set this on a deployed runtime: the runtime never
# migrates, so giving it this credential is unnecessary blast radius.
# Leave empty to reuse SUPABASE_DB_URL.
SUPABASE_MIGRATION_DB_URL=

# Connection pool size. Keep this small on serverless (1-3) because every
# instance holds its own pool; a long-running server can use 5-10.
PG_POOL_MAX=5

# ---------------------------------------------------------------------------
# Sessions — REQUIRED
# ---------------------------------------------------------------------------
# Peppers the HMAC of every session token. Must be at least 32 characters and
# must stay stable, or every user is signed out on restart.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SESSION_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Comma separated extra origins allowed to call the API. Same-origin is always
# allowed. Example: https://www.example.com
ALLOWED_ORIGINS=
# Behind a reverse proxy or load balancer this must stay 1 so req.ip is the real
# client address. Rate limiting depends on it.
TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Rate limiting (requests per window)
# ---------------------------------------------------------------------------
# Login and signup — counted in Postgres, so the limit holds across restarts and
# instances.
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=300000
# Public testimonial submission — counted in Postgres.
RATE_LIMIT_SUBMIT_MAX=8
RATE_LIMIT_SUBMIT_WINDOW_MS=600000
# General API traffic — counted per instance, best effort.
RATE_LIMIT_API_MAX=600
RATE_LIMIT_API_WINDOW_MS=300000
# Rolling 24h ceiling of submissions one business can receive.
SUBMISSION_DAILY_QUOTA=200

# ---------------------------------------------------------------------------
# Transactional email (password reset) — Resend
# ---------------------------------------------------------------------------
# Optional. Without a key the password-reset flow still works end to end, but
# messages go to the development transport (logged, and appended to
# DEV_EMAIL_LOG when set) instead of being delivered.
# RESEND_API_KEY=re_...

# Sender address. The default is Resend's shared TEST sender, which can ONLY
# deliver to the address that owns the Resend account. For real users, verify a
# domain in Resend and set this to an address on it, e.g.
#   EMAIL_FROM="RaveWall <hello@yourdomain.com>"
# EMAIL_FROM="RaveWall <onboarding@resend.dev>"

# Safety valve for the test sender: when set, only this address receives mail;
# every other recipient is skipped locally. Set it to the Resend account
# owner's address while testing without a verified domain.
# EMAIL_TEST_RECIPIENT=you@example.com

# ---------------------------------------------------------------------------
# Local development only (never set these in production)
# ---------------------------------------------------------------------------
# Directory for the in-process development database used by `npm run dev`.
# PGLITE_DIR=.pglite
# Set to 1 to let `npm run seed` write demo data to a production server. There
# is no reason to do this on a real deployment.
# ALLOW_DEMO_SEED=1
