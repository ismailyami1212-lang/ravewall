{
  "name": "ravewall-testimonial-wall",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Collect, moderate and showcase customer testimonials behind a unique share link.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"node --watch scripts/dev-server.mjs\" \"vite\"",
    "build": "vite build && npm run build:widget",
    "build:widget": "vite build --config vite.config.widget.ts",
    "start": "node src/server/index.js",
    "serve": "npm run build && node src/server/index.js",
    "migrate": "node scripts/migrate.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "prod:baseline": "node scripts/prod-baseline.mjs",
    "deploy": "node scripts/deploy.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "seed": "node scripts/seed-demo.mjs",
    "screenshots": "node scripts/screenshot.mjs",
    "smoke": "bash scripts/smoke.sh",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "pg": "^8.23.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@rollup/rollup-linux-x64-gnu": "4.64.7",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.3",
    "supertest": "^7.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.0.2"
  }
}
